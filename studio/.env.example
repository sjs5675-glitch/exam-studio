# 데이터 루트(outputs/inputs 가 있는 레포 루트) 강제 지정 — 선택 사항.
# 비워두면 assemble.py 를 기준으로 자동 탐색한다. 런처 스크립트가 자동 설정하므로
# 보통 손댈 필요 없다. 여러 클론을 쓴다면 셸 프로필에 영구 설정하지 말 것(엉뚱한 루트 고정).
# EXAM_STUDIO_ROOT=""

# 기출작업 양식지(HWPX 템플릿) 경로 — 선택 사항.
# 비워두면 사용자가 업로드한 HWPX를 사용한다. 공통 양식지를 쓰려면
# 해당 .hwpx 경로를 프로젝트 루트 기준 상대경로로 지정한다.
HWPX_TEMPLATE_PATH=""

# SSE 서버 URL (클라이언트에서 직접 연결)
NEXT_PUBLIC_SSE_URL="http://localhost:3021"

# DeepSeek V4 API provider (external API, opt-in only)
DEEPSEEK_API_KEY=""
DEEPSEEK_API_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-v4-pro"

# Gemini / nano-banana image and crop provider (figure 처리에 필요)
GEMINI_API_KEY=""
